@* Custom MiniMart layout using Pico.css
   - Non-default header/footer 
   - Simple markup - Pico handles the styling
   - /css/site.css for tiny overrides
*@
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - IS4439_Project_1</title>

    <!-- Pico.css -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@picocss/pico@2/css/pico.min.css" />

    <!-- CSS overrides -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @* 
        Header and navigation bar that appear on every page.
        The links use tag helpers to move between different parts of the site.
    *@
    <header class="container">
        <nav aria-label="Main navigation">
            <ul>
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="contrast" style="font-weight:700;">MiniMart</a>
                </li>
            </ul>
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                <li><a asp-area="" asp-controller="Shop" asp-action="List">Shop</a></li>
                <li><a asp-area="" asp-controller="Shop" asp-action="Add">Add Product</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
            </ul>
        </nav>
    </header>

    @* 
        The main content of each page is displayed here.
        Each view’s HTML is injected where RenderBody() is.
    *@
    <main class="container">
        @RenderBody()
    </main>

    @* 
        Footer shown on every page.
        Includes the student name, year, and module info.
    *@
    <footer class="container">
        <hr />
        <small>
            &copy; @DateTime.Now.Year - MiniMart - Developed by Daithi Nolan (122377826)
        </small>
    </footer>
</body>
</html>
