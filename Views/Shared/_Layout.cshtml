@* Custom MiniMart layout using Pico.css
   - Non-default header/footer (satisfies CA1 layout requirement)
   - Simple, semantic markup; Pico handles the styling
   - Keep your own ~/css/site.css for tiny overrides
*@
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - IS4439_Project_1</title>

    <!-- Pico.css -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@picocss/pico@2/css/pico.min.css" />

    <!-- Custom CSS overrides -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="container">
        <nav aria-label="Main navigation">
            <ul>
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="contrast" style="font-weight:700;">MiniMart</a>
                </li>
            </ul>
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-area="" asp-controller="Shop" asp-action="List">Shop</a></li>
                <li><a asp-area="" asp-controller="Shop" asp-action="Add" role="button">Add Product</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Privacy" class="secondary">Privacy</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="container">
        <hr />
        <small>
            &copy; @DateTime.Now.Year - MiniMart • Developed by Daithi Nolan (122377826)
            <!-- Pico: https://picocss.com -->
        </small>
    </footer>

    <!-- No Bootstrap/JS required for Pico; keep your app script if needed -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
