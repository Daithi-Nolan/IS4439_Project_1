@model List<IS4439_Project_1.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

@if (!string.IsNullOrWhiteSpace(ViewBag.Message as string))
{
    <article class="contrast">
        @ViewBag.Message
    </article>
}

<table role="grid">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price (€)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price.ToString("0.00")</td>
                <td>@(p.InStock ? "In Stock" : "Out of Stock")</td>
                <td>
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id" role="button" style="background-color: #0074D9">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-controller="Shop" asp-action="Add" role="button" style="background-color: #0074D9">Add Product</a>
</p>
