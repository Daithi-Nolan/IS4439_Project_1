@{
    ViewData["Title"] = "Page Not Found";
}

@* 
    This is the custom 404 error page.
    It appears when a user tries to visit a page that doesn’t exist.
    The links below help them get back to working parts of the site.
*@

<h1>404 — Page not found</h1>
<p>Sorry, we can’t find the page you’re looking for.</p>

<nav>
    <ul>
        <li><a asp-controller="Home" asp-action="Index" role="button">Go Home</a></li>
        <li><a asp-controller="Shop" asp-action="List" role="button" class="secondary">Browse Products</a></li>
    </ul>
</nav>
